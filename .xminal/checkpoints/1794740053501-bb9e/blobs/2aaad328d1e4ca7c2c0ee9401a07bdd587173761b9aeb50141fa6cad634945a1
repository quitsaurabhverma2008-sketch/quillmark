'use strict';

// Quillmark HTML renderer.
// Dependency-free, CommonJS, Node >= 18.
//
// Public API:
//   const { render } = require('./src/render');
//   const html = render({ frontMatter, ast }, { title?: string });

const { escapeHtml } = require('./src/markdown');

// Inline CSS, self-contained, no external assets, no CDN.
const CSS = `
* { box-sizing: border-box; }
body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.6; color: #1a1a1a; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
h1, h2, h3, h4, h5, h6 { color: #0f172a; margin-top: 1.5rem; }
h1 { font-size: 2rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; }
h2 { font-size: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.35rem; }
h3 { font-size: 1.25rem; }
p { margin: 1rem 0; }
ul, ol { margin: 1rem 0 1rem 1.5rem; }
li { margin: 0.35rem 0; }
pre { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; padding: 1rem; overflow-x: auto; }
code { background: #f1f5f9; padding: 0.15rem 0.4rem; border-radius: 4px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
pre code { padding: 0; background: transparent; font-size: 1em; }
a { color: #2563eb; text-decoration: underline; }
`;

function renderInline(children) {
  let html = '';
  for (const c of children) {
    switch (c.type) {
      case 'text':
        html += escapeHtml(c.content);
        break;
      case 'bold':
        html += '<strong>' + escapeHtml(c.content) + '</strong>';
        break;
      case 'italic':
        html += '<em>' + escapeHtml(c.content) + '</em>';
        break;
      case 'code':
        html += '<code>' + escapeHtml(c.content) + '</code>';
        break;
      case 'link':
        html += '<a href="' + escapeHtml(c.href) + '">' + escapeHtml(c.content) + '</a>';
        break;
      default:
        html += escapeHtml(String(c.content));
    }
  }
  return html;
}

// Flatten inline nodes to plain text (used for the page title).
function plainText(children) {
  return children.map(c => {
    if (c.type === 'link') return c.content;
    if (c.type === 'text' || c.type === 'bold' || c.type === 'italic' || c.type === 'code') {
      return c.content;
    }
    return '';
  }).join('');
}

function renderBlock(node) {
  switch (node.type) {
    case 'heading':
      return '<h' + node.level + '>' + renderInline(node.children) + '</h' + node.level + '>';
    case 'paragraph':
      return '<p>' + renderInline(node.children) + '</p>';
    case 'ulist': {
      const items = node.items.map(it => '<li>' + renderInline(it.children) + '</li>').join('');
      return '<ul>' + items + '</ul>';
    }
    case 'olist': {
      const items = node.items.map(it => '<li>' + renderInline(it.children) + '</li>').join('');
      return '<ol>' + items + '</ol>';
    }
    case 'codeBlock': {
      const langClass = node.lang ? ' class="lang-' + escapeHtml(node.lang) + '"' : '';
      return '<pre><code' + langClass + '>' + escapeHtml(node.code) + '</code></pre>';
    }
    default:
      return '';
  }
}

function render(doc, opts) {
  opts = opts || {};
  const frontMatter = doc.frontMatter || {};
  const ast = doc.ast || [];

  // Resolve page title: --title override > front-matter title > first heading.
  let title = opts.title;
  if (!title) title = frontMatter.title || '';
  if (!title) {
    for (const node of ast) {
      if (node.type === 'heading') {
        title = plainText(node.children);
        break;
      }
    }
  }

  const bodyHtml = ast.map(renderBlock).join('\n');

  return (
    '<!DOCTYPE html>\n' +
    '<html lang="en">\n' +
    '<head>\n' +
    '<meta charset="utf-8">\n' +
    '<title>' + escapeHtml(title) + '</title>\n' +
    '<style>' + CSS + '</style>\n' +
    '</head>\n' +
    '<body>\n' +
    bodyHtml +
    '\n</body>\n' +
    '</html>\n'
  );
}

module.exports = { render, CSS };
